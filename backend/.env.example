# Copy to backend/.env for local development. Never commit backend/.env.
PORT=8787
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8080,https://umeshprakashsinghuptet-ai.github.io
DATA_DIR=./data
# Generate a unique random secret with at least 32 bytes for each deployment.
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
# Optional provider credentials; keep them on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BRAVE_SEARCH_API_KEY=
# Payment is not implemented; do not enable live payments based on these fields alone.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional path to FFmpeg binary. MP4 rendering is not implemented in this release.
FFMPEG_PATH=
